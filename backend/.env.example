# Copy to .env for local development. In production these are set as environment variables on the host.
# GramForGrow's own Postgres (Docker container gramforgrow-db, port 5434) - never wap's. The password becomes the container's on first run.
DATABASE_URL=postgresql+asyncpg://gramforgrow:change-me@localhost:5434/gramforgrow

# JWT signing secrets — generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-value

# Encrypts Instagram access tokens, AI keys and integration secrets at rest.
ENCRYPTION_KEY=change-me-to-a-long-random-value

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3001

# ---- Public URLs ----
# PUBLIC_BASE_URL=https://your-api.up.railway.app
# FRONTEND_URL=https://app.gramforgrow.in

# ---- Media library ----
# Uploaded images/videos live here (a persistent volume in production). Instagram downloads them from PUBLIC_BASE_URL,
# so publishing uploaded files needs PUBLIC_BASE_URL to be a public https:// address (an ngrok URL works locally).
# MEDIA_DIR=media_uploads
# MEDIA_QUOTA_MB=2048

# ---- Instagram / Meta (Instagram API with Instagram Login) ----
# INSTAGRAM_GRAPH_BASE=https://graph.instagram.com
GRAPH_API_VERSION=v23.0
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# INSTAGRAM_REDIRECT_URI=http://localhost:3001/dashboard/instagram/callback

# ---- AI agent (optional) ----
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5

# ---- Email (optional) ----
# RESEND_API_KEY=
# EMAIL_FROM=GramForGrow <no-reply@gramforgrow.in>

# ---- Google sign-in ----
# GOOGLE_CLIENT_ID=

# ---- Platform admin ----
# PLATFORM_ADMIN_EMAILS=you@company.com
