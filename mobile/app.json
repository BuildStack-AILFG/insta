{
  "expo": {
    "name": "GramForGrow",
    "slug": "gramforgrow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.gramforgrow.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.gramforgrow.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#ec4899"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0508"
        }
      ]
    ],
    "scheme": "gramforgrow",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://insta-production-b43e.up.railway.app/api",
      "router": {},
      "eas": {
        "projectId": "b1c61d7a-d43d-494b-86a1-6895d0bdb6c9"
      }
    },
    "owner": "gramforgrow"
  }
}
